# ============================================================
# SIPA BACKEND - VARIABLES DE ENTORNO (EJEMPLO)
# ------------------------------------------------------------
# Copie este archivo como backend/.env  (el .env NO se versiona:
# ya está en backend/.gitignore) y ajuste los valores.
#
# Solo hace falta cuando ejecuta la app o Alembic FUERA de Docker
# (con un entorno virtual). Con Docker Compose las variables ya
# vienen en docker-compose.yml.
# ============================================================

# Conexión a PostgreSQL. Mantenga la parte "options=..." : fija el esquema.
DATABASE_URL=postgresql+psycopg2://USUARIO:1234@localhost:5432/sipa_db?options=-c%20search_path=etapa_productiva

# Obligatoria, mínimo 32 caracteres. Genere una propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Alembic también la necesita (importa app.core.config al arrancar).
SECRET_KEY=Joan02Daniel10Rondon09_2026_Juan_Cap_3_16

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
DEBUG=true
